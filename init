#!/usr/bin/env python
import bin.lib.py_src.what as what
import bin.gui.GUI as GUI
import sys
import subprocess
import os
import json
from shutil import which



if __name__ == "__main__":
    print("--------------")
    print(what.getMessage())
    print("--------------")
    if which("fortune"):
        subprocess.call("fortune")
        print("--------------")

    # json_name = GUI.start_gui()
    if len(sys.argv) > 1:
        json_name = sys.argv[1]
    else:
        json_name = GUI.start_gui()

        # if the GUI was closed without running an experiment
        if not json_name:
            print(":P")
            exit(1)
    
    experiment_file = open(json_name, "r")
    params = json.load(experiment_file)

    script = params['-SCRIPT-']

    print(f"Executing {script} with {json_name}")
    subprocess.run([script, json_name])

    print("great success")

